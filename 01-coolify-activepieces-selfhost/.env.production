# ==============================================================================
# PRODUCTION ENVIRONMENT VARIABLES (.env.production)
# Activepieces on Coolify Stack
# ==============================================================================

# Domain & Routing (Must match your DNS record exactly with https:// and NO trailing slash)
AP_FRONTEND_URL=https://automation.yourdomain.com

# Engine Execution Mode (Unsandboxed for low RAM consumption <700MB)
AP_ENGINE_EXECUTOR_MODE=UNSANDBOXED
AP_ENVIRONMENT=production
AP_WEBHOOK_TIMEOUT_SECONDS=30

# Database Credentials
POSTGRES_DB=activepieces
POSTGRES_USER=activepieces_admin
POSTGRES_PASSWORD=generate_a_secure_password_here_32_chars

# Security Keys (Generate via: openssl rand -hex 32)
AP_ENCRYPTION_KEY=replace_with_32_byte_hex_encryption_key
AP_JWT_SECRET=replace_with_32_byte_hex_jwt_secret
