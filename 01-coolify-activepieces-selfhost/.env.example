# Domain & Routing (Must match your DNS record exactly with https://)
AP_FRONTEND_URL=https://automation.yourdomain.com

# Database Credentials
POSTGRES_DB=activepieces
POSTGRES_USER=activepieces_admin
POSTGRES_PASSWORD=generate_a_secure_password_here_32_chars

# Security Keys (Generate via: openssl rand -hex 32)
AP_ENCRYPTION_KEY=replace_with_32_byte_hex_encryption_key
AP_JWT_SECRET=replace_with_32_byte_hex_jwt_secret